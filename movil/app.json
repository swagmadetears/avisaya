{
  "expo": {
    "name": "Avisaya",
    "slug": "avisaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.avisaya.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Avisaya usa la cámara para adjuntar fotos de las averías.",
        "NSPhotoLibraryUsageDescription": "Avisaya usa tus fotos para adjuntar imágenes de las averías."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E4561B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.avisaya.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-font"
      ],
      [
        "expo-image"
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Avisaya usa la cámara para adjuntar fotos de las averías.",
          "photosPermission": "Avisaya usa tus fotos para adjuntar imágenes de las averías."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E4561B",
          "defaultChannel": "partes"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "avisaya"
  }
}
